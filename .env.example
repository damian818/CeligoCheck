# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CELIGO_PROD_API_TOKEN: Your Celigo Production API Bearer token.
# Generate in integrator.io (Production) -> Profile / Settings -> API Keys.
CELIGO_PROD_API_TOKEN=""

# CELIGO_SANDBOX_API_TOKEN: Your Celigo Sandbox API Bearer token.
# Generate in integrator.io (Sandbox) -> Profile / Settings -> API Keys.
CELIGO_SANDBOX_API_TOKEN=""

# CELIGO_API_TOKEN: Fallback API token (used as Production token if CELIGO_PROD_API_TOKEN is not set).
CELIGO_API_TOKEN=""

# CELIGO_STACK: Celigo Cloud Region / Stack (default is US: https://api.integrator.io, or EU: https://api.eu.integrator.io)
CELIGO_STACK="us"

# JIRA_DOMAIN: Your Atlassian Jira domain (e.g., https://gappify.atlassian.net)
JIRA_DOMAIN="https://gappify.atlassian.net"

# JIRA_EMAIL: The email address for Jira API authentication (e.g., damian@gappify.com)
JIRA_EMAIL="damian@gappify.com"

# JIRA_API_TOKEN: Your Atlassian Jira API Token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=""

# JIRA_PROJECT_KEY: Default Jira Project Key for integration incidents (e.g., GS)
JIRA_PROJECT_KEY="GS"

# JIRA_ISSUE_TYPE: Default Jira Issue Type for integration incidents (e.g., Integration Issue)
JIRA_ISSUE_TYPE="Integration Issue"
